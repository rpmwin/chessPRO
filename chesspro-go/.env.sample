PORT=5000
APP_ENV=development

# Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chesspro?sslmode=disable

# Redis
REDIS_ADDR=localhost:6379

# JWT — generate with: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback
CLIENT_HOME_URL=http://localhost:5173

# Gemini
GEMINI_API_KEY=

# Stockfish binary path (must be executable)
STOCKFISH_PATH=/opt/homebrew/bin/stockfish

# CORS
CORS_ORIGIN=http://localhost:5173
